# Copia este archivo a .env (el .env nunca se sube). Lo carga application.properties.

# Base compartida rentamovil con el usuario booking_app (rtm-booking-reservation-db, 03_dcl), nunca sa.
# DATABASE_PASSWORD = el parameter.bookingAppPassword de rtm-booking-reservation-db/liquibase.properties
DATABASE_URL=jdbc:sqlserver://localhost:1433;databaseName=rentamovil;encrypt=true;trustServerCertificate=true
DATABASE_USERNAME=booking_app
DATABASE_PASSWORD=ChangeMe_BookingApp123!

APP_BOOKING_RESERVATION_PORT=3003

# iam: su clave pública se descarga sola de GET /jwks (ya no hace falta copiarla aquí).
# En Docker: http://iam:3001
IAM_URL=http://localhost:3001

# iam: usado para consultar los push tokens Expo del usuario al enviar notificaciones push.
# En Docker: http://iam:3001
IAM_URL=http://localhost:3001

# INV-015: horas que una reserva espera un pago aprobado antes de expirar a CANCELLED
APP_BOOKING_RESERVATION_PAYMENT_WINDOW_HOURS=24
# fleet-maintenance (precio/disponibilidad del vehículo y eventos de renta). En Docker: http://fleet-maintenance:3002
FLEET_URL=http://localhost:3002
# telemetry-gps (destino de RentalStarted/RentalCompleted). En Docker: http://telemetry-gps:3005
TELEMETRY_URL=http://localhost:3005

# Clave compartida para llamar/validar /internal/** entre microservicios (header X-Internal-Key).
# MISMA clave en booking-reservation, fleet-maintenance, payment-billing y telemetry-gps.
APP_INTERNAL_API_KEY=ChangeMe_InternalKey123!
